# ArduFiyat environment template
# Bu dosyaya gerçek secret/API key yazmayın. Kopyalayıp .env olarak kullanın.

NODE_ENV=development
PORT=4173

# Zorunlu güvenlik ayarları (production'da gerçek değer verin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
TOKEN_SECRET=

# Google / Gemini
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PRICE_BATCH_SIZE=8
GEMINI_PRICE_BATCH_DELAY_MS=350
AUTO_GEMINI_DAILY_SYNC=true

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Veritabanı / kalıcı veri
DATABASE_URL=
ARDUFIYAT_DATA_DIR=
ALLOW_LOCAL_DB_FALLBACK=false
PGSSLMODE=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_ATTEMPTS=5

# Genel URL / servis
PUBLIC_BASE_URL=
SITE_URL=

# Public API
ARDUFIYAT_PUBLIC_API_KEY=
PUBLIC_API_RATE_LIMIT=120

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Discord
DISCORD_ALERT_WEBHOOK_URL=
DISCORD_PUBLIC_KEY=

# Otomatik senkronlar
AUTO_PRICE_SYNC=false
PRICE_SYNC_INTERVAL_MINUTES=360
AUTO_IMAGE_SYNC=true
FX_AUTO_SYNC=true
